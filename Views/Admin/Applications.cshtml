@model List<HouseRentalManagementSystem.Models.RentalApplication>
@{
    ViewData["Title"] = "System Applications - Admin";
    var selectedStatus = ViewBag.SelectedStatus as ApplicationStatus?;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Admin Console</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Application Monitoring</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">System Rental Applications</h2>
            <p class="text-muted small mb-0">Monitor all applications submitted by tenants across the entire platform</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Dashboard Overview
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-3 rounded-4 shadow-sm border border-light mb-4">
        <form asp-action="Applications" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Application Statuses</option>
                    <option value="0" selected="@(selectedStatus == ApplicationStatus.Pending)">Pending Applications</option>
                    <option value="1" selected="@(selectedStatus == ApplicationStatus.Approved)">Approved Applications</option>
                    <option value="2" selected="@(selectedStatus == ApplicationStatus.Rejected)">Rejected Applications</option>
                    <option value="3" selected="@(selectedStatus == ApplicationStatus.Cancelled)">Cancelled Applications</option>
                </select>
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-action="Applications" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </a>
            </div>
        </form>
    </div>

    <!-- Applications Table -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="custom-table table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tenant</th>
                        <th style="min-width: 220px;">Property</th>
                        <th>Income</th>
                        <th>Move-in Date</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td class="text-muted small fw-bold">#@app.Id</td>
                            <td>
                                <div class="fw-bold text-dark">@app.Tenant?.FullName</div>
                                <div class="small text-muted">@app.Tenant?.Email</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 220px;">
                                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@app.PropertyId" class="text-decoration-none text-dark hover-primary">
                                        @app.Property?.Title
                                    </a>
                                </div>
                                <div class="small text-muted">@app.Property?.City &bull; $@app.Property?.MonthlyRent.ToString("N0")/mo</div>
                            </td>
                            <td>
                                <span class="fw-bold text-success">$@app.MonthlyIncome.ToString("N0")</span>
                                <div class="small text-muted">@app.Occupation</div>
                            </td>
                            <td>
                                <span class="small text-dark fw-semibold">@app.ProposedMoveInDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                <span class="small text-muted">@app.AppliedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                @if (app.Status == ApplicationStatus.Pending)
                                {
                                    <span class="status-badge status-badge-pending">Pending</span>
                                }
                                else if (app.Status == ApplicationStatus.Approved)
                                {
                                    <span class="status-badge status-badge-approved">Approved</span>
                                }
                                else if (app.Status == ApplicationStatus.Rejected)
                                {
                                    <span class="status-badge status-badge-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-cancelled">Cancelled</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Applications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Inspect
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="bg-white p-5 rounded-4 shadow-sm border text-center my-4">
            <h4 class="fw-bold text-dark">No Applications Found</h4>
            <p class="text-secondary small mb-0">No rental applications match the current filter.</p>
        </div>
    }
</div>

