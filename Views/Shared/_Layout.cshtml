@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentHaven | House Rental Management System</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom Light Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg custom-navbar py-3">
            <div class="container">
                <a class="navbar-brand navbar-brand-logo" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-wrapper">
                        <i class="bi bi-houses-fill"></i>
                    </span>
                    <span>RentHaven</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <!-- Main Navigation Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Properties" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Browse Houses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#how-it-works">
                                <i class="bi bi-compass me-1"></i> How It Works
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#contact-section">
                                <i class="bi bi-envelope me-1"></i> Contact
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-check me-1"></i> Admin Console
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-lg rounded-3" aria-labelledby="adminMenu">
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard Overview</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Properties"><i class="bi bi-building me-2 text-primary"></i> Manage Properties</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2 text-primary"></i> Manage Users</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-text me-2 text-primary"></i> System Applications</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("PropertyOwner"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-semibold" asp-controller="Properties" asp-action="MyProperties">
                                        <i class="bi bi-card-checklist me-1"></i> My Listings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-semibold" asp-controller="Applications" asp-action="OwnerApplications">
                                        <i class="bi bi-inbox me-1"></i> Received Applications
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Tenant"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-semibold" asp-controller="Applications" asp-action="MyApplications">
                                        <i class="bi bi-journal-text me-1"></i> My Applications
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- User Account / Auth Actions -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var role = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("PropertyOwner") ? "Owner" : "Tenant");

                            @if (User.IsInRole("PropertyOwner") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-emerald btn-sm px-3 py-2 me-lg-2" asp-controller="Properties" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> List Property
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-1" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.95rem;">
                                        @(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div class="text-start d-none d-lg-block">
                                        <div class="fw-bold small text-dark leading-none">@currentUser?.FullName</div>
                                        <span class="badge @(role == "Admin" ? "bg-dark" : (role == "Owner" ? "bg-primary" : "bg-success"))" style="font-size: 0.65rem;">@role</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 py-2" aria-labelledby="userMenu" style="min-width: 210px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark">@currentUser?.FullName</div>
                                        <div class="small text-muted text-truncate">@currentUser?.Email</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-muted"></i> My Profile
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Tenant"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Applications" asp-action="MyApplications">
                                                <i class="bi bi-file-earmark-check me-2 text-muted"></i> Rental Applications
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("PropertyOwner"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Properties" asp-action="MyProperties">
                                                <i class="bi bi-houses me-2 text-muted"></i> Manage Properties
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Applications" asp-action="OwnerApplications">
                                                <i class="bi bi-inbox me-2 text-muted"></i> Tenant Applications
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2 text-muted"></i> Admin Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary px-3 py-2" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Get Started
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notification Container -->
    <div class="toast-container-custom" id="toastPlacement">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast custom-toast align-items-center show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6000">
                <div class="d-flex border-start border-4 border-success p-2">
                    <div class="toast-body d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Success</div>
                            <div class="small text-secondary">@TempData["SuccessMessage"]</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast custom-toast align-items-center show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="7000">
                <div class="d-flex border-start border-4 border-danger p-2">
                    <div class="toast-body d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Notice</div>
                            <div class="small text-secondary">@TempData["ErrorMessage"]</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="toast custom-toast align-items-center show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6000">
                <div class="d-flex border-start border-4 border-primary p-2">
                    <div class="toast-body d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Information</div>
                            <div class="small text-secondary">@TempData["InfoMessage"]</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Professional Light Footer -->
    <footer class="custom-footer">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <div class="navbar-brand-logo mb-3">
                        <span class="brand-icon-wrapper">
                            <i class="bi bi-houses-fill"></i>
                        </span>
                        <span>RentHaven</span>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        A modern, dependable platform bridging the gap between property owners and prospective tenants. Discover verified rental houses, apply seamlessly online, and manage properties with ease.
                    </p>
                    <div class="d-flex gap-3 text-primary fs-5 mt-3">
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Properties" asp-action="Index">Browse Properties</a></li>
                        <li><a href="/#how-it-works">How It Works</a></li>
                        <li><a href="/#contact-section">Contact Concierge</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading">Property Types</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Properties" asp-action="Index" asp-route-propertyType="Apartment">Apartments</a></li>
                        <li><a asp-controller="Properties" asp-action="Index" asp-route-propertyType="Villa">Luxury Villas</a></li>
                        <li><a asp-controller="Properties" asp-action="Index" asp-route-propertyType="Independent House">Independent Houses</a></li>
                        <li><a asp-controller="Properties" asp-action="Index" asp-route-propertyType="Studio">Studios</a></li>
                        <li><a asp-controller="Properties" asp-action="Index" asp-route-propertyType="Condo">Modern Condos</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="footer-heading">College Project Submission</h6>
                    <div class="p-3 rounded-3" style="background-color: var(--bg-warm-beige-light); border: 1px solid var(--border-beige);">
                        <div class="fw-bold text-dark small mb-1">House Rental Management System</div>
                        <div class="text-muted small">B.Tech Computer Science & Engineering (AIML)</div>
                        <div class="small text-secondary mt-2">
                            Built with <strong>ASP.NET Core 8 MVC</strong>, C#, Entity Framework Core, SQL Server, and Bootstrap 5.
                        </div>
                        <div class="badge bg-primary-subtle text-primary border border-primary-subtle mt-2">Collegiate Major Project</div>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-top border-light d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-muted">
                <div>
                    &copy; @DateTime.UtcNow.Year RentHaven - House Rental Management System. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
                    <span>&bull;</span>
                    <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                    <span>&bull;</span>
                    <a href="#" class="text-muted text-decoration-none">Security</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Site Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Initialize all Bootstrap Toasts
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            var toastList = toastElList.map(function (toastEl) {
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
                return toast;
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
