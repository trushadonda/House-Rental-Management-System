@model List<HouseRentalManagementSystem.Models.RentalApplication>
@{
    ViewData["Title"] = "Tenant Applications Received";
    var ownerProperties = ViewBag.OwnerProperties as List<HouseRentalManagementSystem.Models.Property> ?? new List<HouseRentalManagementSystem.Models.Property>();
    var selectedPropertyId = ViewBag.SelectedPropertyId as int?;
    var selectedStatus = ViewBag.SelectedStatus as ApplicationStatus?;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Properties" asp-action="MyProperties" class="text-decoration-none">My Properties</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tenant Applications</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Tenant Applications Received</h2>
            <p class="text-muted small mb-0">Review applicant credentials, evaluate financial profiles, and approve or reject submissions</p>
        </div>

        <a asp-controller="Properties" asp-action="MyProperties" class="btn btn-outline-secondary">
            <i class="bi bi-houses me-1"></i> Manage Properties
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-3 rounded-4 shadow-sm border border-light mb-4">
        <form asp-action="OwnerApplications" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="propertyId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Listed Properties</option>
                    @foreach (var p in ownerProperties)
                    {
                        <option value="@p.Id" selected="@(selectedPropertyId == p.Id)">@p.Title (@p.City)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Application Statuses</option>
                    <option value="0" selected="@(selectedStatus == ApplicationStatus.Pending)">Pending Review</option>
                    <option value="1" selected="@(selectedStatus == ApplicationStatus.Approved)">Approved</option>
                    <option value="2" selected="@(selectedStatus == ApplicationStatus.Rejected)">Rejected</option>
                    <option value="3" selected="@(selectedStatus == ApplicationStatus.Cancelled)">Cancelled by Tenant</option>
                </select>
            </div>
            <div class="col-md-3 text-md-end">
                <a asp-action="OwnerApplications" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </a>
            </div>
        </form>
    </div>

    <!-- Applications Table -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="custom-table table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th style="min-width: 220px;">Property</th>
                        <th>Income / Job</th>
                        <th>Occupants</th>
                        <th>Move-in</th>
                        <th>Status</th>
                        <th class="text-end" style="min-width: 160px;">Review Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        @(app.Tenant?.FullName?.Substring(0, 1).ToUpper() ?? "T")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@app.Tenant?.FullName</div>
                                        <div class="small text-muted">@app.Tenant?.Email</div>
                                        <div class="small text-muted"><i class="bi bi-telephone text-primary"></i> @app.Tenant?.PhoneNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 220px;">
                                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@app.PropertyId" class="text-decoration-none text-dark hover-primary">
                                        @app.Property?.Title
                                    </a>
                                </div>
                                <div class="small text-primary fw-semibold">$@app.Property?.MonthlyRent.ToString("N0")/mo</div>
                            </td>
                            <td>
                                <div class="fw-bold text-success">$@app.MonthlyIncome.ToString("N0")/mo</div>
                                <div class="small text-muted text-truncate" style="max-width: 140px;">@app.Occupation</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@app.NumberOfOccupants Person(s)</span>
                            </td>
                            <td>
                                <span class="small text-dark fw-semibold">@app.ProposedMoveInDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                @if (app.Status == ApplicationStatus.Pending)
                                {
                                    <span class="status-badge status-badge-pending">Pending</span>
                                }
                                else if (app.Status == ApplicationStatus.Approved)
                                {
                                    <span class="status-badge status-badge-approved">Approved</span>
                                }
                                else if (app.Status == ApplicationStatus.Rejected)
                                {
                                    <span class="status-badge status-badge-rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-cancelled">Cancelled</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-secondary" title="View Full Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#reviewModal_@app.Id">
                                        <i class="bi bi-pencil-square me-1"></i> Review
                                    </button>
                                </div>

                                <!-- Review & Status Update Modal -->
                                <div class="modal fade text-start" id="reviewModal_@app.Id" tabindex="-1" aria-labelledby="reviewLabel_@app.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <form asp-action="UpdateStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="applicationId" value="@app.Id" />

                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold" id="reviewLabel_@app.Id">
                                                        Review Application: @app.Tenant?.FullName
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body py-3">
                                                    <div class="p-3 bg-light rounded-3 mb-3 small">
                                                        <div><strong>Property:</strong> @app.Property?.Title</div>
                                                        <div><strong>Income:</strong> $@app.MonthlyIncome.ToString("N0") per month</div>
                                                        <div><strong>Occupation:</strong> @app.Occupation</div>
                                                        <div><strong>Move-in Date:</strong> @app.ProposedMoveInDate.ToString("MMMM dd, yyyy")</div>
                                                        @if (!string.IsNullOrEmpty(app.Message))
                                                        {
                                                            <div class="mt-2 text-secondary"><strong>Applicant Message:</strong> "@app.Message"</div>
                                                        }
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Update Status</label>
                                                        <select name="status" class="form-select" required>
                                                            <option value="1" selected="@(app.Status == ApplicationStatus.Approved)">Approve Application</option>
                                                            <option value="2" selected="@(app.Status == ApplicationStatus.Rejected)">Reject Application</option>
                                                            <option value="0" selected="@(app.Status == ApplicationStatus.Pending)">Leave as Pending</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Remarks / Feedback for Tenant</label>
                                                        <textarea name="reviewerRemarks" rows="3" class="form-control" placeholder="Add optional comments or instructions (e.g. Please bring identity documents for lease signing)...">@app.ReviewerRemarks</textarea>
                                                    </div>
                                                </div>

                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary fw-bold">Save Decision</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="bg-white p-5 rounded-4 shadow-sm border text-center my-4">
            <div class="rounded-circle bg-light text-muted mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                <i class="bi bi-inbox fs-2 text-primary"></i>
            </div>
            <h4 class="fw-bold text-dark">No Applications Found</h4>
            <p class="text-secondary small mb-0">No tenant applications match the selected criteria.</p>
        </div>
    }
</div>

