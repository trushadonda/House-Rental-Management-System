@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-white p-5 rounded-4 shadow-sm border border-light">
                <div class="rounded-circle bg-danger-subtle text-danger mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-shield-x fs-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
                <p class="text-secondary mb-4">
                    You do not have the required role permissions to access this administrative resource.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-house me-1"></i> Back to Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign in with another account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

