@model HouseRentalManagementSystem.ViewModels.Property.PropertySearchViewModel
@{
    ViewData["Title"] = "Browse Rental Houses";
}

<div class="container py-4">
    <!-- Header Breadcrumb & Title -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Properties</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Browse Rental Houses</h2>
            <p class="text-muted small mb-0">Showing @Model.Properties.Count of @Model.TotalItems verified properties</p>
        </div>

        @if (User.IsInRole("PropertyOwner") || User.IsInRole("Admin"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-emerald">
                    <i class="bi bi-plus-circle me-1"></i> Post New Property
                </a>
            </div>
        }
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white p-3 p-md-4 rounded-4 shadow-sm border border-light mb-4">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small text-muted"><i class="bi bi-search me-1 text-primary"></i> Keyword / Title</label>
                    <input type="text" asp-for="SearchQuery" class="form-control" placeholder="Search keywords..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label small text-muted"><i class="bi bi-geo-alt me-1 text-primary"></i> City</label>
                    <select asp-for="City" class="form-select">
                        <option value="">All Cities</option>
                        @foreach (var c in Model.AvailableCities)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label small text-muted"><i class="bi bi-building me-1 text-primary"></i> Type</label>
                    <select asp-for="PropertyType" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var t in Model.AvailableTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label small text-muted"><i class="bi bi-door-closed me-1 text-primary"></i> Bedrooms</label>
                    <select asp-for="Bedrooms" class="form-select">
                        <option value="">Any Beds</option>
                        <option value="1">1 BHK</option>
                        <option value="2">2 BHK</option>
                        <option value="3">3 BHK</option>
                        <option value="4">4+ Beds</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-4">
                    <label class="form-label small text-muted"><i class="bi bi-arrow-down-up me-1 text-primary"></i> Sort By</label>
                    <select asp-for="SortBy" class="form-select">
                        <option value="newest">Newest Listed</option>
                        <option value="rent_asc">Rent: Low to High</option>
                        <option value="rent_desc">Rent: High to Low</option>
                        <option value="area_desc">Largest Area (Sq Ft)</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label small text-muted">Min Rent ($)</label>
                    <input type="number" asp-for="MinRent" class="form-control" placeholder="Min $" step="50" />
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label small text-muted">Max Rent ($)</label>
                    <input type="number" asp-for="MaxRent" class="form-control" placeholder="Max $" step="50" />
                </div>

                <div class="col-lg-3 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Properties Grid -->
    @if (Model.Properties != null && Model.Properties.Count > 0)
    {
        <div class="row g-4 mb-5">
            @foreach (var property in Model.Properties)
            {
                <div class="col-lg-4 col-md-6">
                    @await Html.PartialAsync("_PropertyCard", property)
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-city="@Model.City"
                           asp-route-propertyType="@Model.PropertyType"
                           asp-route-bedrooms="@Model.Bedrooms"
                           asp-route-minRent="@Model.MinRent"
                           asp-route-maxRent="@Model.MaxRent"
                           asp-route-sortBy="@Model.SortBy">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@i"
                               asp-route-searchQuery="@Model.SearchQuery"
                               asp-route-city="@Model.City"
                               asp-route-propertyType="@Model.PropertyType"
                               asp-route-bedrooms="@Model.Bedrooms"
                               asp-route-minRent="@Model.MinRent"
                               asp-route-maxRent="@Model.MaxRent"
                               asp-route-sortBy="@Model.SortBy">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-city="@Model.City"
                           asp-route-propertyType="@Model.PropertyType"
                           asp-route-bedrooms="@Model.Bedrooms"
                           asp-route-minRent="@Model.MinRent"
                           asp-route-maxRent="@Model.MaxRent"
                           asp-route-sortBy="@Model.SortBy">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="bg-white p-5 rounded-4 shadow-sm border text-center my-4">
            <div class="rounded-circle bg-light text-muted mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                <i class="bi bi-search fs-2"></i>
            </div>
            <h4 class="fw-bold text-dark">No Properties Found</h4>
            <p class="text-secondary small mb-3">No rental listings match your specific search criteria. Try loosening your filters or changing location.</p>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All Filters
            </a>
        </div>
    }
</div>

